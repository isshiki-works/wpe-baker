{
  "patterns": {
    "dual_waves": { "normalize": true,
      "contains": [
        "float distance = g_Time * g_Speed + dot(texCoordMotion, v_Direction) * g_Scale;",
        "float distance2 = (g_Time + g_Offset2) * g_Speed2 + dot(texCoordMotion, v_Direction2) * g_Scale2;",
        "float val1 = sin(distance);",
        "float val2 = sin(distance2);",
        "texCoord += val1 * s1 * val2 * s2 * offset * strength * mask;",
        "uniform float g_Speed2;",
        "uniform float g_Offset2;" ],
      "uniforms": [ [ "g_Speed2", { "material": "speed2" } ], [ "g_Offset2", { "material": "offset2" } ] ],
      "count": { "word:g_Time": 4, "word:g_Speed": 2, "word:g_Speed2": 2, "word:g_Offset2": 2 } },
    "water_wave": { "normalize": true, "forbid_alternate_clock": true, "any": [
      { "contains": [ "float distance = g_Time * g_Speed;", "sin(distance);" ],
        "count": { "word:g_Time": 2, "word:g_Speed": 2, "word:distance": 2, "assign:distance": 1 } },
      { "contains": [
          "float distance = g_Time * g_Speed + dot(texCoordMotion, v_Direction) * g_Scale;",
          "float val1 = sin(distance);",
          "distance *= step(0.0, v_TexCoordPerspective.z);",
          "distance += timeOffset;" ],
        "count": { "word:g_Time": 4, "word:g_Speed": 2, "word:distance": 4, "assign:distance": 3 } } ] },
    "repeat_noise": { "normalize": true, "forbid_alternate_clock": true,
      "contains": [
        "v_NoiseTexCoord.xy = a_TexCoord + g_Time * g_NoiseSpeed",
        "vec2(-g_Time, g_Time) * 0.5 * g_NoiseSpeed",
        "v_NoiseTexCoord *= g_NoiseScale",
        "texSample2D(g_Texture2, v_NoiseTexCoord.xy)",
        "texSample2D(g_Texture2, v_NoiseTexCoord.zw)",
        "v_NoiseTexCoord.xy = a_TexCoord + g_Time * g_NoiseSpeed;",
        "v_NoiseTexCoord.wz = vec2(a_TexCoord.y, -a_TexCoord.x) * 0.633 + vec2(-g_Time, g_Time) * 0.5 * g_NoiseSpeed;",
        "v_NoiseTexCoord *= g_NoiseScale;" ],
      "uniforms": [ [ "g_Texture2", { "default": "util/clouds_256" } ] ],
      "count": { "word:g_Time": 4, "word:g_NoiseSpeed": 3, "word:g_NoiseScale": 2, "word:v_NoiseTexCoord": 7 },
      "regex": [ [ "\\bv_NoiseTexCoord(?:\\.(?:xy|wz|zw|x|y|z|w))?\\s*(?:\\+=|-=|\\*=|/=|=)", 3 ] ] },
    "repeat_noise_default_on": { "normalize": true, "combos": [ [ "NOISE", { "default": 1 } ] ] },
    "shine_cast_clock": { "normalize": true, "forbid_alternate_clock": true,
      "contains": [ "vec2 baseDirection = rotateVec2(vec2(0, 0.5), g_Time * g_Speed);" ],
      "count": { "word:g_Time": 2, "word:g_Speed": 2, "direct:baseDirection": 1 } },
    "shine_cast_four_directions": { "normalize": true,
      "contains": [
        "rotateVec2(vec2(0, 0.5), g_Time * g_Speed)",
        "#if EDGES == 4",
        "rotateVec2(vec2(-baseDirection.y, baseDirection.x)" ] },
    "shine_edges_default_four": { "normalize": true, "combos": [ [ "EDGES", { "default": 4 } ] ] },
    "scroll": { "normalize": true,
      "contains": [
        "scroll = sign(scroll) * pow(vec2(g_ScrollX, g_ScrollY), CAST2(2.0));",
        "frac((v_TexCoord + v_Scroll) * g_Scale)" ] },
    "water_flow": { "normalize": true,
      "contains": [
        "uniform float g_FlowSpeed;",
        "vec4 cycles = vec4(frac(g_Time * g_FlowSpeed),",
        "frac(g_Time * g_FlowSpeed + 0.5),",
        "frac(0.25 + g_Time * g_FlowSpeed),",
        "frac(0.25 + g_Time * g_FlowSpeed + 0.5));",
        "float flowPhase = texSample2D(g_Texture2, v_TexCoord.xy * g_FlowPhaseScale).r;" ],
      "count": { "word:g_Time": 5, "word:g_FlowSpeed": 5, "word:flowPhase": 2 },
      "uniforms": [ [ "g_FlowSpeed", { "material": "speed" } ] ],
      "regex": [ [ "#(?:if|ifdef|ifndef|elif)\\b", 0 ] ] },
    "shimmer": { "normalize": true,
      "contains": [
        "uniform float u_speed;",
        "uniform float u_scale;",
        "uniform float u_delay;",
        "#if MODE == 1",
        "shimmerCoord.x += u_offset + u_speed * (g_Time + offset);",
        "shimmerCoord.x += u_offset + u_width * sin(u_speed * g_Time + offset);",
        "shimmerCoord.x = saturate(frac(shimmerCoord.x / (u_scale * u_delay)) * u_scale * u_delay);" ],
      "count": { "word:g_Time": 3, "word:u_speed": 3, "word:u_scale": 4, "word:u_delay": 3 },
      "uniforms": [
        [ "u_speed", { "material": "ui_editor_properties_speed", "default": 1, "range": [ 0, 5 ] } ],
        [ "u_scale", { "material": "ui_editor_properties_granularity", "default": 1, "range": [ 1, 5 ] } ],
        [ "u_delay", { "material": "ui_editor_properties_delay", "default": 2, "range": [ 1, 5 ] } ] ] },
    "shimmer_default_mode": { "normalize": true,
      "combos": [ [ "MODE", { "material": "ui_editor_properties_style", "default": 0 } ] ] },
    "shake": { "normalize": true,
      "contains": [
        "float time = g_Speed * g_Time + flowPhase;",
        "offset = sin(frac(time / M_PI_2) * M_PI_2);",
        "float base = step(0.0, cos(time));",
        "vec4 sines = flowPhase + frac(g_Speed * g_Time / M_PI_2 * vec4(1, -0.16161616, 0.0083333, -0.00019841)) * M_PI_2;",
        "float flowPhase = 0.0;",
        "flowPhase = texSample2D(g_Texture2, v_TexCoord.zw).r * M_PI_2;" ],
      "count": { "word:g_Time": 3, "word:flowPhase": 4 } },
    "pulse": { "normalize": true,
      "contains": [
        "uniform float g_PulseSpeed;",
        "uniform float g_NoiseAmount;",
        "float noise = texSample2D(g_Texture1, vec2(g_Time * 0.08333333, g_Time * 0.02777777) * g_NoiseSpeed).r * g_NoiseAmount;" ],
      "vars": { "U": "uniform\\s+float\\s+g_Time\\s*;", "S": "sin\\s*\\(\\s*g_Time\\s*\\*\\s*g_PulseSpeed\\s*\\+" },
      "require": { "S": ">0", "U": "S" },
      "uniforms": [ [ "g_PulseSpeed", { "material": "speed" } ], [ "g_NoiseAmount", { "material": "noiseamount" } ] ],
      "count": { "word:g_Time": "U+S+2", "word:g_PulseSpeed": "U+S", "word:g_NoiseSpeed": 2, "word:g_NoiseAmount": 2 } },
    "sine": { "normalize": true, "contains": [ "sin(g_Time * g_Speed + g_Phase * 6.28318530718) * g_Amount" ] },
    "film_grain": { "normalize": true, "forbid_alternate_clock": true,
      "contains": [
        "float t = frac(g_Time);",
        "v_TexCoordNoise.xy = (a_TexCoord.xy + t) * g_NoiseScale;",
        "v_TexCoordNoise.zw = (a_TexCoord.xy - t * 2.5) * g_NoiseScale * 0.52;" ],
      "count": { "word:g_Time": 2, "word:t": 3, "assign:t": 1 } },
    "crt": { "normalize": true,
      "contains": [
        "uniform float u_frequency;",
        "float speed = g_Time * u_frequency;",
        "albedo.rgb *= 1.0 - min(1.0, mod(1.0 - uv.y * u_amount1 + speed, 1.0) * u_size1) * u_strength1;",
        "albedo.rgb *= 1.0 - abs(mod(1.0 - (uv.y + u_offset2) * u_amount2 + speed, 2.0) - 1.0) * u_strength2;",
        "#if ARTIFACTS" ],
      "uniforms": [ [ "u_frequency", { "material": "Frequency" } ] ],
      "count": { "word:g_Time": 2, "word:u_frequency": 2, "word:speed": 3, "direct:speed": 1 } },
    "light_shafts": { "normalize": true,
      "contains": [
        "uniform float g_Speed;",
        "fxCoord.xy += g_Time * g_Speed * vec2(0.003, 0.000375111);",
        "fxCoord2.xy -= g_Time * g_Speed * vec2(0.0047111, 0.0007399);" ],
      "uniforms": [ [ "g_Speed", { "material": "rayspeed" } ] ],
      "count": { "word:g_Time": 3, "word:g_Speed": 3 } },
    "iris": { "normalize": true,
      "contains": [
        "float time = (g_Time * g_Speed) + g_PhaseOffset;",
        "float lowDt = floor(time);",
        "vec2 motion2 = sin(1.9 * (lowDt + vec2(0, 1)));",
        "vec4 motion4 = sin(2.5 * (lowDt + vec4(0, 0, 1, 1)) + vec4(1, 2, 1, 2));",
        "da.x += sin(time) * g_NoiseAmount;",
        "da.y += cos(time) * g_NoiseAmount;" ],
      "count": { "word:g_Time": 2, "word:g_Speed": 2, "word:time": 5, "word:lowDt": 3 } },
    "foliage_sway": { "normalize": true, "contains": [ "uniform float g_Speed;" ],
      "uniforms": [ [ "g_Speed", { "material": "speed" } ], [ "g_Speed", { "material": "speeduv" } ] ] },
    "foliage_sway_masked_clock": { "normalize": true, "count": { "word:g_Time": 6, "word:g_Speed": 6 } },
    "shadow_hash": { "normalize": true,
      "contains": [
        "vec3 p3 = frac(CAST3(p.xyx) * 0.1031);",
        "p3 += dot(p3, p3.yzx + 33.33);",
        "return frac((p3.x + p3.y) * p3.z);",
        "albedo.rgb *= 1.0 - hash(round(uv) + g_Time) * u_noise;" ],
      "count": { "word:g_Time": 2, "word:u_noise": 2, "word:p3": 7 } },
    "auto_sway": { "normalize": true, "forbid_alternate_clock": true, "any": [
      { "contains": [ "float thisMotionTime = g_Time * g_Speed;", "sin(thisMotionTime * M_PI_2);" ],
        "count": { "word:g_Time": 2, "word:g_Speed": 2, "word:thisMotionTime": 2, "assign:thisMotionTime": 1 } },
      { "count": {
          "substr:float thisMotionTime = g_GlobalTimeOffset + g_Time * g_Speed;": 2,
          "substr:thisMotionRadian = sin(thisMotionTime * M_PI_2);": 2,
          "word:g_Time": 5, "word:g_Speed": 5, "word:thisMotionTime": 32, "assign:thisMotionTime": 26,
          "direct:thisMotionTime": 2, "scaled:thisMotionTime": 0 } } ] },
    "water_ripple_gate": { "normalize": true, "contains": [ "g_AnimationSpeed" ] },
    "water_ripple": { "normalize": true, "forbid_alternate_clock": true,
      "count": {
        "substr:vec2 scroll = rotateVec2(vec2(0, 1), g_Direction) * g_ScrollSpeed * g_ScrollSpeed * g_Time;": 2,
        "substr:float rippleTextureAdjustment = (g_Texture0Resolution.x / g_Texture0Resolution.y);": 2,
        "substr:v_TexCoordRipple.xy = coordsRotated + g_Time * g_AnimationSpeed * g_AnimationSpeed + scroll;": 1,
        "substr:v_TexCoordRipple.zw = coordsRotated2 - g_Time * g_AnimationSpeed * g_AnimationSpeed + scroll;": 1,
        "substr:v_TexCoordRipple *= g_Scale;": 1,
        "substr:v_TexCoordRipple.xz *= rippleTextureAdjustment;": 1,
        "substr:v_TexCoordRipple.yw *= g_Ratio;": 1,
        "substr:rippleCoords = v_TexCoordRipple;": 1,
        "substr:rippleCoords.xy = coordsRotated + g_Time * g_AnimationSpeed * g_AnimationSpeed + scroll;": 1,
        "substr:rippleCoords.zw = coordsRotated2 - g_Time * g_AnimationSpeed * g_AnimationSpeed + scroll;": 1,
        "substr:rippleCoords *= g_Scale;": 1,
        "substr:rippleCoords.xz *= rippleTextureAdjustment;": 1,
        "substr:rippleCoords.yw *= g_Ratio;": 1,
        "substr:vec3 n1 = texSample2D(g_Texture2, rippleCoords.xy).xyz * 2 - 1;": 1,
        "substr:vec3 n2 = texSample2D(g_Texture2, rippleCoords.zw).xyz * 2 - 1;": 1,
        "word:g_Time": 8, "word:g_AnimationSpeed": 10, "word:g_ScrollSpeed": 6, "word:scroll": 6,
        "word:rippleTextureAdjustment": 4, "word:v_TexCoordRipple": 8, "word:rippleCoords": 9, "word:g_Texture2": 3,
        "swizzle:v_TexCoordRipple": 5, "swizzle:rippleCoords": 6 } },
    "structured_sine": { "normalize": true, "contains": [ "uniform float g_Speed;", "sin(" ],
      "uniforms": [ [ "g_Speed", { "material": "speed" } ] ] },
    "noise_branch": { "normalize": true, "contains": [ "#if NOISE" ] },
    "audio_off_branch": { "normalize": true, "contains": [ "#if AUDIOPROCESSING == 0" ] },
    "noise_default_off": { "normalize": true, "combos": [ [ "NOISE", { "default": 0 } ] ] },
    "audio_default_off": { "normalize": true, "combos": [ [ "AUDIOPROCESSING", { "default": 0 } ] ] },
    "artifacts_default_on": { "normalize": true, "combos": [ [ "ARTIFACTS", { "default": 1 } ] ] }
  },
  "rules": [
    { "id": "dual_waves", "action": "dual_waves", "combo": "DUALWAVES",
      "unreadable": "DUALWAVES combo value is neither an integer nor a boolean, so the active wave branch is not proven.",
      "mismatch": "Dual water-wave source has an unverified equation or additional clock input." },
    { "id": "water_wave", "action": "scalar_period", "match": [ "water_wave" ],
      "speed_key": "speed", "zero": "missing", "period_numerator": "2pi", "component": "speed",
      "missing": "Verified water-wave timing needs a nonzero scalar 'speed' constant.",
      "evidence": "Verified sin(g_Time * g_Speed + spatial phase) in {resource}; source speed token is {speed}." },
    { "id": "repeat_noise", "action": "repeat_noise", "match": [ "repeat_noise" ] },
    { "id": "scroll", "action": "scroll", "match": [ "scroll" ] },
    { "id": "water_flow", "action": "scalar_period", "match": [ "water_flow" ],
      "speed_key": "speed", "zero": "static", "period_numerator": 1, "component": "speed",
      "missing": "Verified four-phase water flow timing needs a finite scalar 'speed' constant.",
      "evidence": "Verified four frac(g_Time * g_FlowSpeed) phases return together after 1/abs(speed); source speed token is {speed}. Auxiliary texture timing remains an independent constraint." },
    { "id": "shimmer", "action": "shimmer", "match": [ "shimmer" ] },
    { "id": "shake", "action": "scalar_period", "match": [ "shake" ],
      "gates": [
        { "type": "combo_off", "combo": "NOISE", "directive": "noise_branch",
          "absent_enabled_unless": "noise_default_off",
          "kind": "NonPeriodicOrDriftingMechanism",
          "detail": "Shake NOISE is enabled or unproven; its multiple time coefficients do not establish a short exact loop." },
        { "type": "combo_off", "combo": "AUDIOPROCESSING", "directive": "audio_off_branch",
          "absent_enabled_unless": "audio_default_off",
          "kind": "NonPeriodicOrDriftingMechanism",
          "detail": "Shake is driven by enabled or unproven external audio instead of its periodic time equation." } ],
      "speed_key": "speed", "zero": "static", "period_numerator": "2pi", "component": "speed",
      "missing": "Verified wrapped shake timing needs a finite scalar 'speed' constant.",
      "evidence": "Verified wrapped sin/cos(g_Time * g_Speed + static phase) shake timing; source speed token is {speed}." },
    { "id": "pulse", "action": "scalar_period", "match": [ "pulse" ],
      "gates": [
        { "type": "combo_off", "combo": "AUDIOPROCESSING",
          "absent_enabled_unless": "audio_default_off",
          "kind": "NonPeriodicOrDriftingMechanism",
          "detail": "Pulse is driven by enabled or unproven external audio instead of its periodic time equation." },
        { "type": "constant_zero", "key": "noiseamount",
          "missing": "Verified pulse timing needs a finite authored 'noiseamount' to prove that noise drift is disabled.",
          "kind": "NonPeriodicOrDriftingMechanism",
          "detail": "Pulse noise UV drift is enabled, so the simple pulse speed does not prove closure." } ],
      "speed_key": "speed", "zero": "static", "period_numerator": "2pi", "component": "speed",
      "missing": "Verified noise-disabled pulse timing needs a finite scalar 'speed' constant.",
      "evidence": "Verified all active g_Time terms reduce to sin(g_Time * g_PulseSpeed + static phase) when authored noiseamount is zero; source speed token is {speed}." },
    { "id": "sine", "action": "scalar_period", "match": [ "sine" ],
      "gates": [
        { "type": "combo_off", "combo": "NOISE", "directive": "noise_branch",
          "absent_enabled_unless": "noise_default_off",
          "kind": "NonPeriodicOrDriftingMechanism",
          "detail": "Verified sine timing has enabled or unproven NOISE, so its simple speed period does not prove closure." } ],
      "speed_key": "speed", "zero": "static", "period_numerator": "2pi", "component": "speed",
      "missing": "Verified sine timing needs a scalar 'speed' constant.",
      "evidence": "Verified sin(g_Time * g_Speed + g_Phase * 2π) timing; speed token is {speed}." },
    { "id": "film_grain", "action": "film_grain", "match": [ "film_grain" ] },
    { "id": "crt", "action": "scalar_period", "match": [ "crt" ],
      "gates": [
        { "type": "combo_on", "combo": "ARTIFACTS",
          "absent_enabled_if": "artifacts_default_on",
          "kind": "UnsupportedShaderMechanism",
          "detail": "CRT ARTIFACTS combo value is neither an integer nor a boolean, so the scan-line branch is not proven disabled." } ],
      "speed_key": "Frequency", "zero": "static", "period_numerator": 2, "component": "frequency",
      "missing": "Verified CRT scan-line timing needs a finite scalar 'Frequency' constant.",
      "evidence": "Verified scan-line mod(...,1.0) and flicker mod(...,2.0) over g_Time * u_frequency; joint period is 2/abs({speed})." },
    { "id": "light_shafts", "action": "light_shafts", "match": [ "light_shafts" ] },
    { "id": "iris", "action": "iris", "match": [ "iris" ] },
    { "id": "foliage_sway", "action": "foliage_sway", "match": [ "foliage_sway" ] },
    { "id": "shadow_hash", "action": "shadow_hash", "match": [ "shadow_hash" ] },
    { "id": "auto_sway", "action": "auto_sway", "match": [ "auto_sway" ],
      "gates": [
        { "type": "combo_off", "combo": "NOISE", "directive": "noise_branch",
          "kind": "NonPeriodicOrDriftingMechanism",
          "detail": "Auto-sway noise is enabled, so the simple speed period does not prove closure." } ] },
    { "id": "water_ripple", "action": "water_ripple", "match": [ "water_ripple_gate", "water_ripple" ] },
    { "id": "structured_sine", "action": "structured_sine", "match": [ "structured_sine" ] }
  ]
}
