<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>wpe-baker</AssemblyName>
    <Version>1.1.0-preview.1</Version>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../Baker.Core/Baker.Core.csproj" /></ItemGroup>
  <!-- 周期数学与判据类型在 Periodica.Domain（C2.1a/C2.1c 搬迁）；全局 using 让调用方写法不变。 -->
  <ItemGroup><Using Include="Periodica.Domain" /></ItemGroup>
</Project>
