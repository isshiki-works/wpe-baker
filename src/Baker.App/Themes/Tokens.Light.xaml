<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 浅色颜色键。键名与 Tokens.Dark.xaml 一一对应；控件样式（Controls.xaml）一律用 DynamicResource 引用。 -->
    <SolidColorBrush x:Key="Bg" Color="#F3F3F3"/> <!-- 窗口底色（不透明模式）；云母/亚克力时窗口底透明，由系统画 -->
    <SolidColorBrush x:Key="Pane" Color="#CCFAFAFA"/> <!-- 左右两个窗格：80% 不透明，云母/亚克力只透 20% -->
    <SolidColorBrush x:Key="Card" Color="#FFFFFF"/> <!-- 卡片、作业行、输入框：不透明，文字都放在这上面 -->
    <SolidColorBrush x:Key="Fill" Color="#EBEBEB"/> <!-- 分段底、悬停 -->
    <SolidColorBrush x:Key="Stroke" Color="#E5E5E5"/> <!-- 卡片描边 -->
    <SolidColorBrush x:Key="Stroke2" Color="#D0D0D0"/> <!-- 输入框与按钮描边 -->
    <SolidColorBrush x:Key="Ink" Color="#1A1A1A"/> <!-- 主文字 -->
    <SolidColorBrush x:Key="Ink2" Color="#505050"/> <!-- 次要文字（最坏情况对比度 ≥ 4.5:1） -->
    <SolidColorBrush x:Key="Ink3" Color="#8A8A8A"/> <!-- 仅禁用与占位 -->
    <SolidColorBrush x:Key="Accent" Color="#0F7B6C"/> <!-- 强调填充 -->
    <SolidColorBrush x:Key="AccentInk" Color="#FFFFFF"/> <!-- 强调填充上的字 -->
    <SolidColorBrush x:Key="AccentText" Color="#0A5A4F"/> <!-- 强调色文字 -->
    <SolidColorBrush x:Key="AccentSoft" Color="#E4F1EE"/> <!-- 强调淡底 -->
    <SolidColorBrush x:Key="BadText" Color="#A21B12"/> <!-- 失败文字 -->
    <SolidColorBrush x:Key="BadSoft" Color="#FDE7E9"/> <!-- 失败淡底 -->
</ResourceDictionary>
