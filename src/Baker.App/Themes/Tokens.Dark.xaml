<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 深色颜色键。键名与 Tokens.Light.xaml 一一对应；控件样式（Controls.xaml）一律用 DynamicResource 引用。
         窗口底是系统云母/亚克力（自带深色色调与亮度层），卡片、控件只再叠一层很淡的白，数值取自 WinUI 的 Card/Control 填充。 -->
    <SolidColorBrush x:Key="Bg" Color="#202020"/> <!-- 窗口底色与标题栏（不透明模式） -->
    <SolidColorBrush x:Key="Base" Color="#73202020"/> <!-- 云母/亚克力上再压一层 45% 深底：亮壁纸下系统深色亚克力偏灰，正文对比度不够 -->
    <SolidColorBrush x:Key="Card" Color="#12FFFFFF"/> <!-- 玻璃卡片：7% 白，背后材质几乎全透；不透明模式下叠成 #2D2D2D -->
    <SolidColorBrush x:Key="Field" Color="#0FFFFFFF"/> <!-- 卡片上的输入框、按钮、内嵌块：再叠一层 6% 白 -->
    <SolidColorBrush x:Key="Solid" Color="#2C2C2C"/> <!-- 下拉弹层：不透明 -->
    <SolidColorBrush x:Key="Fill" Color="#1B1B1B"/> <!-- 分段底、悬停 -->
    <SolidColorBrush x:Key="Stroke" Color="#2EFFFFFF"/> <!-- 内嵌块描边、分隔线 -->
    <SolidColorBrush x:Key="Stroke2" Color="#4A4A4A"/> <!-- 输入框与按钮描边 -->
    <LinearGradientBrush x:Key="Edge" StartPoint="0,0" EndPoint="0,1"> <!-- 卡片描边：顶部高光渐隐，做玻璃边 -->
        <GradientStop Color="#59FFFFFF" Offset="0"/><GradientStop Color="#0DFFFFFF" Offset="0.35"/><GradientStop Color="#0DFFFFFF" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Ink" Color="#FFFFFF"/> <!-- 主文字 -->
    <SolidColorBrush x:Key="Ink2" Color="#D0D0D0"/> <!-- 次要文字 -->
    <SolidColorBrush x:Key="Ink3" Color="#B0B0B0"/> <!-- 仅禁用与占位 -->
    <SolidColorBrush x:Key="Accent" Color="#4CC2AE"/> <!-- 强调填充 -->
    <SolidColorBrush x:Key="AccentInk" Color="#062520"/> <!-- 强调填充上的字 -->
    <SolidColorBrush x:Key="AccentText" Color="#7FE3D0"/> <!-- 强调色文字、已完成 -->
    <SolidColorBrush x:Key="AccentSoft" Color="#1E3632"/> <!-- 强调淡底（实色小底衬） -->
    <SolidColorBrush x:Key="BusyText" Color="#A8D0FF"/> <!-- 进行中 -->
    <SolidColorBrush x:Key="BadText" Color="#FFBAC1"/> <!-- 失败文字 -->
</ResourceDictionary>
