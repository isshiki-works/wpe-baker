<Window x:Class="Baker.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Periodica · WPE Baker" Icon="Periodica.ico" Width="1240" Height="950"
        MinWidth="980" MinHeight="720" Background="{DynamicResource Bg}" Foreground="{DynamicResource Ink}"
        FontFamily="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI" FontSize="13" Loaded="WindowLoaded" Closing="WindowClosing"
        AllowDrop="True" PreviewDragOver="SourceDragOver" PreviewDrop="SourceDropped">
    <Window.Resources>
        <ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Themes/Controls.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <!-- 顶栏只放两个下拉；标题交给系统标题栏，不在玻璃上直接放字。 -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="12,4,12,8">
            <ComboBox x:Name="BackdropBox" Width="110" Margin="0,0,8,0" SelectionChanged="BackdropChanged" ToolTipService.ShowOnDisabled="True">
                <ComboBoxItem Tag="不透明|Opaque"/><ComboBoxItem Tag="云母|Mica"/><ComboBoxItem Tag="亚克力|Acrylic" IsSelected="True"/>
            </ComboBox>
            <ComboBox x:Name="LanguageBox" Width="110" SelectionChanged="LanguageChanged">
                <ComboBoxItem Content="中文" IsSelected="True"/><ComboBoxItem Content="English"/>
            </ComboBox>
        </StackPanel>
        <Grid Grid.Row="1" Margin="8,0,8,8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="448"/><ColumnDefinition Width="4"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <!-- 左：这张怎么烘。窗格本身不铺底，内容分成几张浮起的玻璃卡片；外边距 4 给阴影留位置，免得被滚动区裁掉。 -->
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="4,0,4,8">
                        <Border Style="{StaticResource Glass}" Padding="20,16,20,18">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Section}" Margin="0,0,0,10" Tag="生成方案|Generation setup"/>
                                <DockPanel Margin="0,0,0,8">
                                    <Button x:Name="DetectButton" DockPanel.Dock="Right" Style="{StaticResource Link}" Tag="刷新|Refresh" Click="DetectClicked"/>
                                    <TextBlock Style="{StaticResource Group}" Margin="0" VerticalAlignment="Center" Tag="当前壁纸|Current wallpaper"/>
                                </DockPanel>
                                <!-- 多块屏幕时在这里挑；一块都没检出就整行收起。 -->
                                <ComboBox x:Name="CurrentWallpaperBox" DisplayMemberPath="Label" SelectionChanged="CurrentWallpaperChanged" Margin="0,0,0,8"
                                    ToolTip="{Binding SelectedItem.Detail, RelativeSource={RelativeSource Self}}">
                                    <ComboBox.Style><Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}"><Style.Triggers>
                                        <Trigger Property="HasItems" Value="False"><Setter Property="Visibility" Value="Collapsed"/></Trigger>
                                    </Style.Triggers></Style></ComboBox.Style>
                                </ComboBox>
                                <!-- 当前壁纸：预览图 + 标题；选中项没有可导入的来源时换成下面的拖入区。 -->
                                <Border x:Name="CurrentWallpaperCard" DataContext="{Binding SelectedItem, ElementName=CurrentWallpaperBox}" Padding="0" ToolTip="{Binding Detail}">
                                    <Border.Style><Style TargetType="Border" BasedOn="{StaticResource Inset}"><Style.Triggers>
                                        <DataTrigger Binding="{Binding}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                        <DataTrigger Binding="{Binding Source}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                    </Style.Triggers></Style></Border.Style>
                                    <StackPanel>
                                        <Border Height="200" CornerRadius="7,7,0,0" Background="{DynamicResource Fill}">
                                            <Border CornerRadius="7,7,0,0"><Border.Background><ImageBrush ImageSource="{Binding Preview}" Stretch="UniformToFill"/></Border.Background></Border>
                                        </Border>
                                        <StackPanel Margin="14,12,14,14">
                                            <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,0,0,10"/>
                                            <Border Background="{DynamicResource AccentSoft}" CornerRadius="10" Padding="10,3" HorizontalAlignment="Left">
                                                <TextBlock FontSize="12" Foreground="{DynamicResource AccentText}"
                                                    Tag="来自 Wallpaper Engine|From Wallpaper Engine"/>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <Grid>
                                    <Grid.Style><Style TargetType="Grid"><Style.Triggers>
                                        <DataTrigger Binding="{Binding Visibility, ElementName=CurrentWallpaperCard}" Value="Visible"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                    </Style.Triggers></Style></Grid.Style>
                                    <Rectangle RadiusX="8" RadiusY="8" Stroke="{DynamicResource Stroke2}" StrokeDashArray="4 3" Fill="{DynamicResource Field}"/>
                                    <StackPanel Margin="16,26" HorizontalAlignment="Center">
                                        <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource Icons}" FontSize="28" Foreground="{DynamicResource AccentText}" HorizontalAlignment="Center"/>
                                        <TextBlock FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,8,0,4"
                                            Tag="拖入壁纸文件夹|Drop a wallpaper folder here"/>
                                        <TextBlock Style="{StaticResource Note}" HorizontalAlignment="Center" TextAlignment="Center"
                                            Tag="也可选择文件或文件夹|Or choose a file or folder"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                                            <Button Tag="选择文件…|Choose file…" Click="ChooseSourceFile"/>
                                            <Button Tag="选择文件夹…|Choose folder…" Click="ChooseSource" Margin="0,0,0,8"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                                <!-- 结论框：分析前整块收起（跟着 VerdictLine 的可见性走）。 -->
                                <Border Background="{DynamicResource AccentSoft}" CornerRadius="8" Padding="14" Margin="0,12,0,0"
                                        Visibility="{Binding Visibility, ElementName=VerdictLine}">
                                    <StackPanel>
                                        <TextBlock x:Name="VerdictLine" FontSize="15" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="NumbersLine" Foreground="{DynamicResource Ink2}" FontSize="13" Margin="0,4,0,0"/>
                                        <Button x:Name="SuggestionButton" Visibility="Collapsed" Tag="按建议重新分析|Re-analyze with suggestion"
                                                Click="ApplySuggestionClicked" Margin="0,8,0,0" HorizontalAlignment="Left"/>
                                        <TextBlock x:Name="PresetAppliedLine" Style="{StaticResource Note}" Margin="0,6,0,0"/>
                                        <!-- plain-language:tech-begin 折叠的技术细节：纯数字表，禁用词扫描跳过这一段。 -->
                                        <Expander x:Name="DetailsExpander" Tag="技术细节|Technical details" Header="技术细节" Margin="0,4,0,0" FontSize="12" FontWeight="Normal">
                                            <StackPanel x:Name="NumbersTable" Margin="0,4,0,0"/>
                                        </Expander>
                                        <!-- plain-language:tech-end -->
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Glass}" Margin="0,12,0,0" Padding="20,16">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="84"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <TextBlock Style="{StaticResource Label}" Tag="动画精度|Animation precision"/>
                                <ComboBox x:Name="PresetBox" Grid.Column="1" SelectionChanged="PresetChanged">
                                    <ComboBoxItem Tag="效率|Efficiency"/>
                                    <ComboBoxItem Tag="平衡|Balanced" IsSelected="True"/>
                                    <ComboBoxItem Tag="质量|Quality"/>
                                </ComboBox>
                                <TextBlock x:Name="PresetNote" Grid.Row="1" Grid.Column="1" Style="{StaticResource Note}" Margin="0,4,0,10"/>
                                <TextBlock Grid.Row="2" Style="{StaticResource Label}" Tag="交互处理|Interaction"/>
                                <ComboBox x:Name="InteractionBox" Grid.Row="2" Grid.Column="1" SelectionChanged="SettingsChanged">
                                    <ComboBoxItem Tag="保留|Keep"/>
                                    <ComboBoxItem Tag="固定视角|Fixed view" IsSelected="True"/>
                                    <ComboBoxItem Tag="关闭|Off"/>
                                </ComboBox>
                                <TextBlock x:Name="InteractionNote" Grid.Row="3" Grid.Column="1" Style="{StaticResource Note}" Margin="0,4,0,10"/>
                                <TextBlock Grid.Row="4" Style="{StaticResource Label}" Tag="输出|Output"/>
                                <DockPanel Grid.Row="4" Grid.Column="1">
                                    <Button x:Name="OutputEditButton" DockPanel.Dock="Right" Content="&#xE70F;" FontFamily="{StaticResource Icons}" MinWidth="32" Padding="8,6" Margin="8,0,0,0"
                                        Click="ToggleOutputEditor" ToolTip="输出帧率与分辨率。‖Output frame rate and resolution."/>
                                    <TextBlock x:Name="OutputSummary" VerticalAlignment="Center"/>
                                </DockPanel>
                                <Grid x:Name="OutputEditor" Grid.Row="5" Grid.ColumnSpan="2" Visibility="Collapsed" Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="84"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="8"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <TextBlock Style="{StaticResource Label}" Tag="帧率|Frame rate"/>
                                    <ComboBox x:Name="FpsBox" Grid.Column="1" IsEditable="True" Text="60" LostFocus="SettingsChanged" SelectionChanged="SettingsChanged" KeyUp="FpsEdited">
                                        <ComboBoxItem Content="60"/><ComboBoxItem Content="120"/><ComboBoxItem Content="144"/><ComboBoxItem Content="165"/><ComboBoxItem Content="240"/><ComboBoxItem Content="60000/1001"/>
                                    </ComboBox>
                                    <TextBlock Grid.Row="2" Style="{StaticResource Label}" Tag="分辨率|Resolution"/>
                                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                                        <TextBox x:Name="WidthBox" Width="76" Text="" TextChanged="SettingsChanged" LostFocus="SettingsChanged"
                                            ToolTip="两项留空按当前屏幕分辨率确定；指定分辨率需两项都填。‖Leave both empty to follow the current screen resolution, or fill both in to set one."/>
                                        <TextBlock Text=" × " VerticalAlignment="Center" Foreground="{DynamicResource Ink2}"/>
                                        <TextBox x:Name="HeightBox" Width="76" Text="" TextChanged="SettingsChanged" LostFocus="SettingsChanged"
                                            ToolTip="两项留空按当前屏幕分辨率确定；指定分辨率需两项都填。‖Leave both empty to follow the current screen resolution, or fill both in to set one."/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                            <Border x:Name="TurnOffCard" Visibility="Collapsed" Style="{StaticResource Glass}" Margin="0,12,0,0" Padding="20,16">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Group}" FontSize="13" Tag="本次未包含|Not included"/>
                                    <StackPanel x:Name="TurnOffList"/>
                                </StackPanel>
                            </Border>
                        <!-- 专业选项：在左栏原地展开，Windows 设置式分组。 -->
                        <Border Style="{StaticResource Glass}" Padding="20,6" Margin="0,12,0,0">
                            <Expander x:Name="AdvancedExpander" Tag="高级|Advanced" Header="高级">
                                <StackPanel Margin="0,6,0,10" TextElement.FontWeight="Normal">
                                    <TextBlock Style="{StaticResource Note}" Margin="0,0,0,10"
                                        Tag="高级设置，默认值适用于多数壁纸。|Advanced settings; the defaults apply to most wallpapers."/>
                                    <WrapPanel Margin="0,0,0,6">
                                        <Button x:Name="LoadPresetButton" Tag="载入设置…|Load settings…" Click="LoadPresetClicked"/>
                                        <Button x:Name="SavePresetButton" Tag="保存设置…|Save settings…" Click="SavePresetClicked"/>
                                    </WrapPanel>
                                    <TextBlock Style="{StaticResource Group}" FontSize="13" Tag="壁纸来源与输出位置|Wallpaper source and output location"/>
                                    <TextBlock Style="{StaticResource Label}" Margin="0,0,0,4" Tag="壁纸来源|Wallpaper source"/>
                                    <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBox x:Name="SourceBox" TextChanged="SourceChanged" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                        <Button Grid.Column="1" Tag="选择文件…|Choose file…" Click="ChooseSourceFile" Margin="6,0,0,0"/>
                                        <Button Grid.Column="2" Tag="选择文件夹…|Choose folder…" Click="ChooseSource" Margin="6,0,0,0"/>
                                    </Grid>
                                    <TextBlock Style="{StaticResource Label}" Margin="0,0,0,4" Tag="Wallpaper Engine 资源目录（assets）|Wallpaper Engine assets folder"/>
                                    <DockPanel Margin="0,0,0,8">
                                        <Button DockPanel.Dock="Right" Margin="6,0,0,0" Tag="选择…|Browse…" Click="ChooseAssets"/>
                                        <TextBox x:Name="AssetsBox" TextChanged="SourceChanged" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                    </DockPanel>
                                    <TextBlock Style="{StaticResource Label}" Margin="0,0,0,4" Tag="输出目录|Output directory"/>
                                    <DockPanel Margin="0,0,0,12">
                                        <Button DockPanel.Dock="Right" Margin="6,0,0,0" Tag="选择…|Browse…" Click="ChooseOutput"/>
                                        <TextBox x:Name="OutputBox" TextChanged="SettingsChanged" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                    </DockPanel>
                                    <TextBlock Style="{StaticResource Group}" FontSize="13" Tag="画面取舍|Visual tradeoffs"/>
                                    <CheckBox x:Name="LayeredVideoBox" Checked="SettingsChanged" Unchecked="SettingsChanged"
                                        ToolTip="部分壁纸只能生成分层视频；分层视频的省电效果未经实测。‖Some wallpapers can only be generated as layered video; its power saving has not been measured.">
                                        <TextBlock Tag="允许分层视频|Allow layered video"/></CheckBox>
                                    <CheckBox x:Name="AudioEffectsBox" Visibility="Collapsed" Checked="SettingsChanged" Unchecked="SettingsChanged"
                                        ToolTip="灯光不再随音乐变化。‖Lighting no longer follows the music.">
                                        <TextBlock Tag="禁用音频响应光效|Disable audio-driven lighting"/></CheckBox>
                                    <TextBlock Style="{StaticResource Group}" FontSize="13" Margin="0,8,0,8" Tag="循环周期调节|Loop period tuning"/>
                                    <TextBlock Style="{StaticResource Note}" Margin="0,0,0,8"
                                        Tag="画面差异预算默认随“动画精度”变化，手动填写后以填写值为准。|The difference budget follows Animation precision by default; a value entered here takes priority."/>
                                    <CheckBox x:Name="RetimeBox" IsChecked="True" Checked="SettingsChanged" Unchecked="SettingsChanged"
                                        ToolTip="调整动画速度以缩短循环周期。‖Adjusts animation speed to shorten the loop period.">
                                        <TextBlock Tag="允许调速|Allow retiming"/>
                                    </CheckBox>
                                    <DockPanel Margin="0,2,0,0"
                                        ToolTip="取值 0–5%，留空则跟随动画精度。‖0–5 %; leave empty to follow Animation precision.">
                                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource Label}" Tag="画面差异预算|Difference budget"/>
                                        <TextBlock x:Name="RetimeBudgetOrigin" DockPanel.Dock="Right" Style="{StaticResource Note}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                        <TextBox x:Name="RetimeBudgetBox" Width="88" HorizontalAlignment="Left" TextChanged="RetimeBudgetEdited" LostFocus="SettingsChanged"/>
                                    </DockPanel>
                                    <TextBlock Style="{StaticResource Group}" FontSize="13" Margin="0,14,0,8" Tag="显卡与编码器|Graphics card and encoder"/>
                                    <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="8"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <TextBlock Style="{StaticResource Label}" Tag="渲染显卡|Render GPU"/>
                                        <ComboBox x:Name="GpuBox" Grid.Column="1" DisplayMemberPath="Name" SelectionChanged="SettingsChanged"/>
                                        <TextBlock Grid.Row="2" Style="{StaticResource Label}" Tag="视频编码器|Video encoder"/>
                                        <ComboBox x:Name="EncoderBox" Grid.Row="2" Grid.Column="1" SelectionChanged="SettingsChanged"
                                            ToolTip="自动：支持的显卡上用 Vulkan 直接编码，速度更快，否则用软件编码。‖Auto uses Vulkan on supported GPUs for faster encoding, otherwise software.">
                                            <ComboBoxItem Tag="软件|Software"/><ComboBoxItem Tag="自动|Auto" IsSelected="True"/><ComboBoxItem Content="Vulkan"/><ComboBoxItem Content="Media Foundation"/><ComboBoxItem Content="NVENC"/><ComboBoxItem Content="Quick Sync"/><ComboBoxItem Content="AMF"/>
                                        </ComboBox>
                                    </Grid>
                                    <CheckBox x:Name="MatchEffectResolutionBox" Checked="SettingsChanged" Unchecked="SettingsChanged" Margin="0,0,0,8"
                                        ToolTip="按输出尺寸和图层实际大小调整特效纹理；关闭时保持原壁纸的特效分辨率。‖Adjusts effect textures to the output and actual layer size; when off, the wallpaper's own effect resolution is kept.">
                                        <TextBlock Tag="特效分辨率随输出调整|Scale effect resolution to output"/>
                                    </CheckBox>
                                    <Expander x:Name="LayersExpander" Tag="图层清单|Layer list" Header="图层清单" Margin="0,4,0,0" IsEnabled="False" FontSize="13">
                                        <StackPanel Margin="0,8,0,0" TextElement.FontWeight="Normal">
                                            <TextBlock Style="{StaticResource Note}" Margin="0,0,0,8"
                                                Tag="勾选的图层将被排除，修改后需重新分析。壁纸自带开关在壁纸属性或 Wallpaper Engine 中调整。|Ticked layers are excluded; re-analyze after changing. The wallpaper's own switches are under wallpaper properties, or in Wallpaper Engine."/>
                                            <ScrollViewer MaxHeight="230" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="LayersEditor"/></ScrollViewer>
                                        </StackPanel>
                                    </Expander>
                                    <Expander x:Name="PropertiesExpander" Tag="壁纸属性|Wallpaper properties" Header="壁纸属性" Margin="0,4,0,0" FontSize="13">
                                        <StackPanel Margin="0,8,0,0" TextElement.FontWeight="Normal"><TextBlock x:Name="PropertyScopeText" Style="{StaticResource Note}" Margin="0,0,0,8"/>
                                            <ScrollViewer MaxHeight="230" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="PropertiesEditor"/></ScrollViewer>
                                        </StackPanel>
                                    </Expander>
                                </StackPanel>
                            </Expander>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
                <Border Grid.Row="1" Style="{StaticResource Glass}" Margin="4" Padding="16,14">
                        <StackPanel>
                            <DockPanel>
                                <Button x:Name="AnalyzeButton" DockPanel.Dock="Left" Tag="分析|Analyze" Click="AnalyzeClicked" MinHeight="40" Margin="0,0,8,0"/>
                                <Button x:Name="GenerateButton" Style="{StaticResource Primary}" Tag="开始生成|Start generating" Click="GenerateClicked"/>
                            </DockPanel>
                            <TextBlock x:Name="ValidationText" FontSize="12" Margin="0,8,0,0"/>
                        </StackPanel>
                </Border>
            </Grid>
            <!-- 右：烘得怎样 -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Border Style="{StaticResource Glass}" Margin="4,0,4,0" Padding="20,12">
                        <DockPanel>
                            <Button x:Name="LoadResultButton" DockPanel.Dock="Right" Tag="打开已有输出…|Open existing output…" Click="LoadResultClicked" Margin="0" VerticalAlignment="Center"/>
                            <TextBlock Style="{StaticResource Section}" VerticalAlignment="Center" Tag="任务|Tasks"/>
                        </DockPanel>
                    </Border>
                    <Grid Grid.Row="1" Margin="0,8,0,0">
                        <Border x:Name="QueueEmpty" Style="{StaticResource Glass}" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="32,28">
                        <StackPanel>
                            <Grid Width="88" Height="88" Margin="0,0,0,14">
                                <Ellipse Fill="{DynamicResource AccentSoft}"/>
                                <TextBlock Text="&#xE8EE;" FontFamily="{StaticResource Icons}" FontSize="34" Foreground="{DynamicResource AccentText}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock FontSize="15" Foreground="{DynamicResource Ink2}" HorizontalAlignment="Center" TextAlignment="Center"
                                Tag="暂无任务|No tasks"/>
                            <!-- 新手三步：分析过就收起（UpdatePlanSummary 控制）。 -->
                            <WrapPanel x:Name="GettingStartedHint" HorizontalAlignment="Center" Margin="0,12,0,0">
                                <Border Style="{StaticResource Inset}" CornerRadius="14" Padding="12,5" Margin="4,0"><TextBlock FontSize="12" Tag="1 选择壁纸|1 Choose a wallpaper"/></Border>
                                <Border Style="{StaticResource Inset}" CornerRadius="14" Padding="12,5" Margin="4,0"><TextBlock FontSize="12" Tag="2 分析|2 Analyze"/></Border>
                                <Border Style="{StaticResource Inset}" CornerRadius="14" Padding="12,5" Margin="4,0"><TextBlock FontSize="12" Tag="3 开始生成|3 Start generating"/></Border>
                            </WrapPanel>
                        </StackPanel>
                        </Border>
                        <ListBox x:Name="QueueList" SelectionChanged="QueueSelectionChanged" BorderThickness="0" Background="Transparent" Padding="4,0"
                                 HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="False">
                            <!-- 作业行：选中时下方 ActionsHost 展开，代码把同一块操作面板（JobActions）挪进来，即"原地展开"。 -->
                            <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem">
                                <Setter Property="Margin" Value="0,0,0,10"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/>
                                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Row" Background="{DynamicResource Card}" BorderBrush="{DynamicResource Edge}" BorderThickness="1" CornerRadius="10">
                                        <Grid>
                                            <StackPanel>
                                                <ContentPresenter/>
                                                <Border x:Name="ActionsHost" BorderBrush="{DynamicResource Stroke}" BorderThickness="0,1,0,0" Padding="14,12,14,6" Visibility="Collapsed"/>
                                            </StackPanel>
                                            <Border x:Name="Mark" Width="3" Height="18" CornerRadius="0,2,2,0" Background="{DynamicResource Accent}"
                                                    HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,14,0,0" Visibility="Collapsed"/>
                                        </Grid>
                                    </Border><ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource Stroke2}"/></Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ActionsHost" Property="Visibility" Value="Visible"/>
                                            <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate></Setter.Value></Setter>
                            </Style></ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate><DataTemplate>
                                <Grid Margin="14,12">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Title}"/>
                                        <TextBlock Text="{Binding Settings}" FontSize="12" Foreground="{DynamicResource Ink2}" Margin="0,2,0,0"/>
                                        <TextBlock Text="{Binding Detail}" ToolTip="{Binding Detail}" Foreground="{DynamicResource Ink2}" FontSize="13" Margin="0,6,0,0"
                                                   MaxHeight="120" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" FontSize="13" FontWeight="SemiBold" Margin="12,0,0,0"/>
                                </Grid>
                            </DataTemplate></ListBox.ItemTemplate>
                        </ListBox>
                        <!-- 没有选中作业时操作面板停在这里（不显示），仍留在逻辑树里好跟着切语言。 -->
                        <Border x:Name="ActionsParking" Visibility="Collapsed">
                            <StackPanel x:Name="JobActions">
                                <WrapPanel>
                                    <Button x:Name="RetryButton" Tag="重新生成|Regenerate" Click="RetryClicked"
                                        ToolTip="重新执行生成，结果写入新目录。‖Runs generation again and writes the result to a new directory."/>
                                    <Button x:Name="ResultButton" Tag="打开输出目录|Open output directory" Click="OpenResultClicked"/>
                                    <Button x:Name="ExportButton" Tag="导出 ZIP|Export ZIP" Click="ExportClicked"/>
                                    <Button x:Name="ErrorButton" Tag="打开错误日志|Open error log" Click="OpenErrorClicked"/>
                                </WrapPanel>
                                <TextBlock Style="{StaticResource Group}" FontSize="13" Margin="0,4,0,8" Tag="检查|Checks"/>
                                <WrapPanel><Button x:Name="OfficialPreviewButton" Tag="在 Wallpaper Engine 中预览|Preview in Wallpaper Engine" Click="OfficialPreviewClicked"/>
                                    <Button x:Name="ValidateButton" Tag="查看自动检查结果|View automatic checks" Click="ValidateClicked"/>
                                    <Button x:Name="ReportButton" Tag="打开报告|Open report" Click="OpenReportClicked"/></WrapPanel>
                                <Expander Tag="应用到桌面|Apply to desktop" Margin="0,2,0,6" FontSize="13" x:Name="DesktopExpander" Header="应用到桌面" IsExpanded="True">
                                    <StackPanel Margin="0,8,0,0" TextElement.FontWeight="Normal">
                                        <TextBlock Style="{StaticResource Label}" HorizontalAlignment="Left" Margin="0,0,0,4" Tag="Wallpaper Engine 可执行文件|Wallpaper Engine executable"/>
                                        <DockPanel><Button DockPanel.Dock="Right" Tag="选择…|Browse…" Click="ChooseWallpaperExecutable" Margin="6,0,0,0"/>
                                            <TextBox x:Name="WpeExeBox" TextChanged="WallpaperExecutableChanged" FontSize="12"
                                                ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/></DockPanel>
                                        <TextBlock Style="{StaticResource Label}" HorizontalAlignment="Left" Margin="0,10,0,4" Tag="目标屏幕|Target screen"/>
                                        <DockPanel><Button x:Name="RefreshTargetsButton" DockPanel.Dock="Right" Tag="刷新|Refresh" Click="RefreshTargetsClicked" Margin="6,0,0,0"/>
                                            <ComboBox x:Name="TargetBox" DisplayMemberPath="Label" SelectionChanged="SettingsChanged" ToolTip="{Binding SelectedItem.Target.CurrentFile, RelativeSource={RelativeSource Self}}"/></DockPanel>
                                        <WrapPanel Margin="0,12,0,0"><Button x:Name="ApplyButton" Style="{StaticResource Primary}" MinHeight="32" FontSize="13" Margin="0,0,8,8"
                                                Tag="应用到桌面|Apply to desktop" Click="ApplyClicked"/>
                                            <Button x:Name="RollbackButton" Tag="恢复上一个壁纸|Restore previous wallpaper" Click="RollbackClicked"/>
                                            <Button x:Name="RollbackFileButton" Tag="从恢复记录还原…|Restore from a restore point…" Click="RollbackClicked"/></WrapPanel>
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <!-- 状态栏：进度、状态、耗时；"取消"对分析和选中作业都生效，所以放在这里而不是作业行里。 -->
                    <Border Grid.Row="2" Style="{StaticResource Glass}" Margin="4,8,4,4" Padding="20,12">
                        <DockPanel>
                            <Button x:Name="CancelButton" DockPanel.Dock="Right" Tag="取消|Cancel" Click="CancelClicked" Margin="12,0,0,0" VerticalAlignment="Center"/>
                            <StackPanel>
                                <ProgressBar x:Name="RunProgress" Maximum="1" Margin="0,0,0,8"/>
                                <TextBlock x:Name="StatusText" Foreground="{DynamicResource Ink2}" FontSize="12"/>
                                <TextBlock x:Name="RunTimingText" Foreground="{DynamicResource Ink2}" FontSize="12"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
