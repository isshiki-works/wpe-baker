<Window x:Class="Baker.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Periodica · WPE Baker" Width="1240" Height="950"
        MinWidth="980" MinHeight="720" Background="#F3F5F8" FontFamily="Segoe UI, Microsoft YaHei UI"
        FontSize="13" Foreground="#1E293B" Loaded="WindowLoaded" Closing="WindowClosing"
        AllowDrop="True" PreviewDragOver="SourceDragOver" PreviewDrop="SourceDropped">
    <Window.Resources>
        <SolidColorBrush x:Key="Ink" Color="#1E293B"/>
        <SolidColorBrush x:Key="Muted" Color="#5A6A80"/>
        <SolidColorBrush x:Key="Hint" Color="#7C8AA0"/>
        <SolidColorBrush x:Key="Line" Color="#E2E7EF"/>
        <SolidColorBrush x:Key="Accent" Color="#3465D9"/>
        <SolidColorBrush x:Key="Ok" Color="#157347"/>
        <SolidColorBrush x:Key="Bad" Color="#C0392B"/>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,8"/><Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#D6DDE7"/>
            <Setter Property="Foreground" Value="#26354B"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border><ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.82"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.4"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#3465D9"/><Setter Property="BorderBrush" Value="#3465D9"/>
            <Setter Property="Foreground" Value="White"/><Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="15,11"/><Setter Property="Margin" Value="0"/>
        </Style>
        <Style TargetType="TextBox"><Setter Property="Padding" Value="9,7"/><Setter Property="BorderBrush" Value="#D6DDE7"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/></Style>
        <Style TargetType="ComboBox"><Setter Property="Padding" Value="8,6"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
        <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
        <Style TargetType="CheckBox"><Setter Property="Margin" Value="0,0,0,8"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/></Style>
        <Style TargetType="Expander"><Setter Property="Foreground" Value="#3B4A60"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
        <Style x:Key="Label" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="0,0,12,0"/></Style>
        <Style x:Key="Section" TargetType="TextBlock"><Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{StaticResource Ink}"/></Style>
        <Style x:Key="Group" TargetType="TextBlock"><Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="#46566E"/>
            <Setter Property="Margin" Value="0,0,0,8"/></Style>
        <Style x:Key="Note" TargetType="TextBlock"><Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource Hint}"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
        <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="20"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="BorderThickness" Value="1"/></Style>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,16">
            <ComboBox x:Name="LanguageBox" DockPanel.Dock="Right" Width="115" Height="34" VerticalAlignment="Center" SelectionChanged="LanguageChanged">
                <ComboBoxItem Content="中文" IsSelected="True"/><ComboBoxItem Content="English"/>
            </ComboBox>
            <TextBlock Text="Periodica · WPE Baker" FontSize="26" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </DockPanel>
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,16">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="106"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/><RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="Auto"/><RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock Grid.ColumnSpan="3" Style="{StaticResource Group}" Tag="壁纸来源与输出位置|Wallpaper source and output location"/>
                <TextBlock Grid.Row="2" Style="{StaticResource Label}" Tag="当前桌面壁纸|Current desktop wallpaper"/>
                <ComboBox x:Name="CurrentWallpaperBox" Grid.Row="2" Grid.Column="1" DisplayMemberPath="Label" SelectionChanged="CurrentWallpaperChanged"
                    ToolTip="{Binding SelectedItem.Detail, RelativeSource={RelativeSource Self}}"/>
                <Button x:Name="DetectButton" Grid.Row="2" Grid.Column="2" Margin="10,0,0,0" MinWidth="146" Tag="重新检测|Re-detect" Click="DetectClicked"/>
                <TextBlock Grid.Row="4" Style="{StaticResource Label}" Tag="壁纸来源|Wallpaper source"/>
                <TextBox x:Name="SourceBox" Grid.Row="4" Grid.Column="1" TextChanged="SourceChanged"
                    ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                <StackPanel Grid.Row="4" Grid.Column="2" Orientation="Horizontal" Margin="10,0,0,0">
                    <Button Tag="选文件…|File…" Click="ChooseSourceFile" Padding="9,8" Margin="0,0,6,0" MinWidth="70"/>
                    <Button Tag="选文件夹…|Folder…" Click="ChooseSource" Padding="9,8" Margin="0" MinWidth="70"/>
                </StackPanel>
                <TextBlock Grid.Row="6" Style="{StaticResource Label}" Tag="Wallpaper Engine assets 目录|Wallpaper Engine assets directory"/>
                <TextBox x:Name="AssetsBox" Grid.Row="6" Grid.Column="1" TextChanged="SourceChanged"
                    ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                <Button Grid.Row="6" Grid.Column="2" Margin="10,0,0,0" MinWidth="146" Tag="选择…|Browse…" Click="ChooseAssets"/>
                <TextBlock Grid.Row="8" Style="{StaticResource Label}" Tag="输出目录|Output directory"/>
                <TextBox x:Name="OutputBox" Grid.Row="8" Grid.Column="1" TextChanged="SettingsChanged"
                    ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                <Button Grid.Row="8" Grid.Column="2" Margin="10,0,0,0" MinWidth="146" Tag="选择…|Browse…" Click="ChooseOutput"/>
                <TextBlock Grid.Row="9" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,8,0,0" Style="{StaticResource Note}"
                    Tag="支持将壁纸目录拖入窗口。|Wallpaper directories can be dropped onto this window."/>
            </Grid>
        </Border>
        <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,14">
                        <Button x:Name="AnalyzeButton" DockPanel.Dock="Right" Tag="分析|Analyze"
                            Click="AnalyzeClicked" Margin="0" VerticalAlignment="Center"/>
                        <TextBlock Style="{StaticResource Section}" VerticalAlignment="Center" Tag="生成方案|Generation setup"/>
                    </DockPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Group}" Tag="动画精度|Animation precision"/>
                            <ComboBox x:Name="PresetBox" SelectionChanged="PresetChanged" Margin="0,0,0,6">
                                <ComboBoxItem Tag="效率|Efficiency"/>
                                <ComboBoxItem Tag="平衡|Balanced"/>
                                <ComboBoxItem Tag="质量|Quality" IsSelected="True"/>
                            </ComboBox>
                            <TextBlock x:Name="PresetNote" Style="{StaticResource Note}" Margin="0,0,0,8"/>
                            <TextBlock Style="{StaticResource Group}" Tag="交互处理|Interaction"/>
                            <ComboBox x:Name="InteractionBox" SelectionChanged="SettingsChanged" Margin="0,0,0,6">
                                <ComboBoxItem Tag="保留|Keep"/>
                                <ComboBoxItem Tag="固定视角|Fixed view" IsSelected="True"/>
                                <ComboBoxItem Tag="关闭|Off"/>
                            </ComboBox>
                            <TextBlock x:Name="InteractionNote" Style="{StaticResource Note}" Margin="0,0,0,12"/>
                            <CheckBox x:Name="MeasureSourceBox" Margin="0,0,0,16"
                                ToolTip="在 Wallpaper Engine 中播放原作并实测核显功耗，约 60 s；无功耗计数器的机器跳过该步骤。‖Plays the original in Wallpaper Engine and measures iGPU power for about 60 s; machines without a power counter skip this step.">
                                <TextBlock Tag="测原作功耗（约 60 秒，可选）|Measure original power (about 60 s, optional)"/></CheckBox>
                            <TextBlock Style="{StaticResource Group}" Tag="输出|Output"/>
                            <DockPanel Margin="0,0,0,4">
                                <Button x:Name="OutputEditButton" DockPanel.Dock="Right" Content="✎" MinWidth="38" Padding="8,6" Margin="8,0,0,0"
                                    Click="ToggleOutputEditor" ToolTip="输出帧率与分辨率。‖Output frame rate and resolution."/>
                                <TextBlock x:Name="OutputSummary" VerticalAlignment="Center" Foreground="{StaticResource Ink}"/>
                            </DockPanel>
                            <Grid x:Name="OutputEditor" Visibility="Collapsed" Margin="0,8,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <TextBlock Style="{StaticResource Label}" Tag="帧率|Frame rate"/>
                                <ComboBox x:Name="FpsBox" Grid.Column="1" IsEditable="True" Text="60" LostFocus="SettingsChanged" SelectionChanged="SettingsChanged" KeyUp="FpsEdited">
                                    <ComboBoxItem Content="60"/><ComboBoxItem Content="120"/><ComboBoxItem Content="144"/><ComboBoxItem Content="165"/><ComboBoxItem Content="240"/><ComboBoxItem Content="60000/1001"/>
                                </ComboBox>
                                <TextBlock Grid.Row="2" Style="{StaticResource Label}" Tag="分辨率|Resolution"/>
                                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                                    <TextBox x:Name="WidthBox" Width="76" Text="" TextChanged="SettingsChanged" LostFocus="SettingsChanged"
                                        ToolTip="两项留空按当前屏幕分辨率确定；指定分辨率需两项都填。‖Leave both empty to follow the current screen resolution, or fill both in to set one."/>
                                    <TextBlock Text=" × " VerticalAlignment="Center" Foreground="{StaticResource Muted}"/>
                                    <TextBox x:Name="HeightBox" Width="76" Text="" TextChanged="SettingsChanged" LostFocus="SettingsChanged"
                                        ToolTip="两项留空按当前屏幕分辨率确定；指定分辨率需两项都填。‖Leave both empty to follow the current screen resolution, or fill both in to set one."/>
                                </StackPanel>
                            </Grid>
                            <Border BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,16,0,12" Background="#F8FAFD">
                                <StackPanel>
                                    <StackPanel x:Name="GettingStartedHint">
                                        <TextBlock Tag="1 把壁纸文件夹拖进来|1 Drag in a wallpaper folder" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,4"/>
                                        <TextBlock Tag="2 选择档位|2 Pick a preset" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,4"/>
                                        <TextBlock Tag="3 点击生成开始|3 Click Generate" Foreground="{StaticResource Muted}" FontSize="12"/>
                                    </StackPanel>
                                    <TextBlock x:Name="VerdictLine" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/>
                                    <TextBlock x:Name="NumbersLine" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0"/>
                                    <Button x:Name="SuggestionButton" Visibility="Collapsed" Tag="按建议重新分析|Re-analyze with suggestion"
                                            Click="ApplySuggestionClicked" Margin="0,8,0,0" HorizontalAlignment="Left"/>
                                    <TextBlock x:Name="PresetAppliedLine" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0"/>
                                    <!-- plain-language:tech-begin 折叠的技术细节：纯数字表，禁用词扫描跳过这一段。 -->
                                    <Expander x:Name="DetailsExpander" Tag="技术细节|Technical details" Header="技术细节" Margin="0,8,0,0" FontSize="12" FontWeight="Normal">
                                        <StackPanel x:Name="NumbersTable" Margin="0,8,0,0"/>
                                    </Expander>
                                    <!-- plain-language:tech-end -->
                                </StackPanel>
                            </Border>
                            <Border x:Name="TurnOffCard" Visibility="Collapsed" BorderBrush="{StaticResource Line}" BorderThickness="1"
                                    CornerRadius="8" Padding="14" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Group}" FontSize="13" Tag="本次未包含|Not included in this bake"/>
                                    <StackPanel x:Name="TurnOffList"/>
                                </StackPanel>
                            </Border>
                            <Expander x:Name="AdvancedExpander" Tag="高级|Advanced" Header="高级" Margin="0,4,0,8">
                                <StackPanel Margin="0,10,0,0" TextElement.FontWeight="Normal">
                                    <TextBlock Style="{StaticResource Note}" Margin="0,0,0,10"
                                        Tag="高级设置，默认值适用于多数壁纸。|Advanced settings; the defaults apply to most wallpapers."/>
                                    <WrapPanel Margin="0,0,0,10">
                                        <Button x:Name="LoadPresetButton" Tag="载入设置…|Load settings…" Click="LoadPresetClicked" Margin="0,0,6,0"/>
                                        <Button x:Name="SavePresetButton" Tag="保存设置…|Save settings…" Click="SavePresetClicked" Margin="0"/>
                                    </WrapPanel>
                                    <TextBlock Style="{StaticResource Group}" Tag="画面取舍|Visual tradeoffs"/>
                                    <CheckBox x:Name="LayeredVideoBox" Checked="SettingsChanged" Unchecked="SettingsChanged"
                                        ToolTip="部分壁纸仅在分层模式下可生成；分层成品的功耗收益需单独实测。‖Some wallpapers can only be generated in layered mode; the power saving of a layered result must be measured separately.">
                                        <TextBlock Tag="允许分层视频|Allow layered video"/></CheckBox>
                                    <CheckBox x:Name="AudioEffectsBox" Visibility="Collapsed" Checked="SettingsChanged" Unchecked="SettingsChanged"
                                        ToolTip="禁用音频响应。‖Disables audio response.">
                                        <TextBlock Tag="禁用音频响应光效|Disable audio-driven lighting"/></CheckBox>
                                    <TextBlock Style="{StaticResource Group}" Margin="0,8,0,8" Tag="循环周期调节|Loop period tuning"/>
                                    <TextBlock Style="{StaticResource Note}" Margin="0,0,0,8"
                                        Tag="以下两项默认取自预设；手动填写后以填写值为准。|Both default to the preset; a value entered here overrides it."/>
                                    <CheckBox x:Name="RetimeBox" IsChecked="True" Checked="SettingsChanged" Unchecked="SettingsChanged"
                                        ToolTip="允许调速以缩短循环周期，画面差异通常可忽略。‖Allows retiming to shorten the loop period; the visual difference is usually negligible.">
                                        <TextBlock Tag="允许调速|Allow retiming"/>
                                    </CheckBox>
                                    <!-- 默认勾选在构造函数里按 SwayRetimeOptions.OnByDefault 设，与命令行的 sway-retime 开关共用同一个默认值。 -->
                                    <CheckBox x:Name="SwayRetimeBox" Checked="SettingsChanged" Unchecked="SettingsChanged"
                                        ToolTip="默认启用。启用时循环周期显著缩短；禁用后摆动图层会使循环周期过长或无解。‖On by default. Enabled, the loop period is much shorter; disabled, swaying layers make it too long or unsolvable.">
                                        <TextBlock Tag="摆动图层对齐循环周期|Align swaying layers to the loop period"/>
                                    </CheckBox>
                                    <DockPanel Margin="0,2,0,0"
                                        ToolTip="画面差异预算，取值 0 到 5 %；留空取预设值。‖Visual difference budget from 0 to 5 %; leave empty to use the preset value.">
                                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource Label}" Tag="画面差异预算|Difference budget"/>
                                        <TextBlock x:Name="RetimeBudgetOrigin" DockPanel.Dock="Right" Style="{StaticResource Note}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                        <TextBox x:Name="RetimeBudgetBox" Width="88" HorizontalAlignment="Left" TextChanged="RetimeBudgetEdited" LostFocus="SettingsChanged"/>
                                    </DockPanel>
                                    <TextBlock Style="{StaticResource Group}" Margin="0,14,0,8" Tag="显卡与编码器|Graphics card and encoder"/>
                                    <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <TextBlock Style="{StaticResource Label}" Tag="渲染显卡|Render GPU"/>
                                        <ComboBox x:Name="GpuBox" Grid.Column="1" DisplayMemberPath="Name" SelectionChanged="SettingsChanged"/>
                                        <TextBlock Grid.Row="2" Style="{StaticResource Label}" Tag="播放版编码器|Playback encoder"/>
                                        <ComboBox x:Name="EncoderBox" Grid.Row="2" Grid.Column="1" SelectionChanged="SettingsChanged"
                                            ToolTip="仅影响桌面播放版本；母版始终使用软件编码。所选编码器本机不可用时回退为软件编码。‖Affects the desktop playback copy only; the master is always software-encoded, and an unavailable encoder falls back to software.">
                                            <ComboBoxItem Content="software" IsSelected="True"/><ComboBoxItem Content="auto"/><ComboBoxItem Content="mf"/><ComboBoxItem Content="nvenc"/><ComboBoxItem Content="qsv"/><ComboBoxItem Content="amf"/>
                                        </ComboBox>
                                    </Grid>
                                    <Expander x:Name="LayersExpander" Tag="图层清单|Layer list" Header="图层清单" Margin="0,4,0,0" IsEnabled="False" FontSize="12">
                                        <StackPanel Margin="0,8,0,0" TextElement.FontWeight="Normal">
                                            <TextBlock Style="{StaticResource Note}" Margin="0,0,0,8"
                                                Tag="勾选的图层将被排除，修改后需重新分析。壁纸自带开关在壁纸属性或 Wallpaper Engine 中调整。|Ticked layers are excluded; re-analyze after changing. The wallpaper's own switches are under wallpaper properties, or in Wallpaper Engine."/>
                                            <ScrollViewer MaxHeight="230" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="LayersEditor"/></ScrollViewer>
                                        </StackPanel>
                                    </Expander>
                                    <Expander x:Name="PropertiesExpander" Tag="壁纸属性|Wallpaper properties" Header="壁纸属性" Margin="0,8,0,0" FontSize="12">
                                        <StackPanel Margin="0,8,0,0" TextElement.FontWeight="Normal"><TextBlock x:Name="PropertyScopeText" Style="{StaticResource Note}" Margin="0,0,0,8"/>
                                            <ScrollViewer MaxHeight="230" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="PropertiesEditor"/></ScrollViewer>
                                        </StackPanel>
                                    </Expander>
                                    <CheckBox x:Name="CompatibilityBox" Checked="SettingsChanged" Unchecked="SettingsChanged" Margin="0,14,0,0">
                                        <TextBlock Tag="兼容模式（1.0 旧默认）|Compatibility mode (1.0 defaults)"/>
                                    </CheckBox>
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>
                    <StackPanel Grid.Row="2" Margin="0,16,0,0">
                        <Button x:Name="GenerateButton" Style="{StaticResource Primary}" Tag="开始生成|Start generating" Click="GenerateClicked"/>
                        <TextBlock x:Name="ValidationText" Foreground="{StaticResource Hint}" FontSize="11" Margin="0,8,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,14">
                        <Button x:Name="LoadResultButton" DockPanel.Dock="Right" Tag="打开已有成品…|Open an existing result…" Click="LoadResultClicked" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        <TextBlock Style="{StaticResource Section}" VerticalAlignment="Center" Tag="任务|Tasks"/>
                    </DockPanel>
                    <Grid Grid.Row="1"><TextBlock x:Name="QueueEmpty" Tag="队列为空。分析壁纸后开始生成。|Queue empty. Analyze a wallpaper, then start generating." Foreground="{StaticResource Hint}" Margin="16,24" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"/>
                        <ListBox x:Name="QueueList" SelectionChanged="QueueSelectionChanged" BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,9"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate><DataTemplate><Border BorderBrush="#DDE5EF" BorderThickness="1" CornerRadius="7" Padding="12">
                                <StackPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Title}"/>
                                    <TextBlock Text="{Binding Settings}" FontSize="11" Foreground="#7B899B" Margin="0,4,0,8"/>
                                    <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" FontSize="12" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Detail}" ToolTip="{Binding Detail}" Foreground="#5A6A80" FontSize="11" Margin="0,5,0,0" MaxHeight="120" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Border></DataTemplate></ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                    <StackPanel Grid.Row="2" Margin="0,14,0,0">
                        <TextBlock Style="{StaticResource Group}" Tag="选中任务|Selected task"/>
                        <WrapPanel><Button x:Name="CancelButton" Tag="取消|Cancel" Click="CancelClicked"/>
                            <Button x:Name="RetryButton" Tag="重新生成|Regenerate" Click="RetryClicked"
                                ToolTip="重新执行生成，结果写入新目录。‖Runs generation again and writes the result to a new directory."/>
                            <Button x:Name="ResultButton" Tag="打开输出目录|Open output directory" Click="OpenResultClicked"/>
                            <Button x:Name="ExportButton" Tag="导出 ZIP|Export ZIP" Click="ExportClicked"/>
                            <Button x:Name="ErrorButton" Tag="打开错误日志|Open error log" Click="OpenErrorClicked"/></WrapPanel>
                        <TextBlock Style="{StaticResource Group}" Margin="0,6,0,8" Tag="校验|Verification"/>
                        <WrapPanel><Button x:Name="OfficialPreviewButton" Tag="在 Wallpaper Engine 中预览|Preview in Wallpaper Engine" Click="OfficialPreviewClicked"/>
                            <Button x:Name="ValidateButton" Tag="查看自动校验结果|View automatic checks" Click="ValidateClicked"/>
                            <Button x:Name="MeasurePlaybackButton" Tag="实测功耗收益（原作对比成品，约 5 min）|Measure power saving (original vs result, about 5 min)" Click="MeasurePlaybackClicked"/>
                            <Button x:Name="ReportButton" Tag="打开报告|Open report" Click="OpenReportClicked"/></WrapPanel>
                        <Expander Tag="应用到桌面|Apply to desktop" Margin="0,8,0,0" FontSize="12" x:Name="DesktopExpander" Header="应用到桌面" IsExpanded="True">
                            <StackPanel Margin="0,10,0,0" TextElement.FontWeight="Normal">
                                <TextBlock Style="{StaticResource Label}" HorizontalAlignment="Left" Margin="0,0,0,5" Tag="Wallpaper Engine 可执行文件|Wallpaper Engine executable"/>
                                <DockPanel><Button DockPanel.Dock="Right" Tag="选择…|Browse…" Click="ChooseWallpaperExecutable" Margin="6,0,0,0" Padding="10,6"/>
                                    <TextBox x:Name="WpeExeBox" TextChanged="WallpaperExecutableChanged" FontSize="11" Padding="7,5"
                                        ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/></DockPanel>
                                <TextBlock Style="{StaticResource Label}" HorizontalAlignment="Left" Margin="0,10,0,5" Tag="目标屏幕|Target screen"/>
                                <DockPanel><Button x:Name="RefreshTargetsButton" DockPanel.Dock="Right" Tag="刷新|Refresh" Click="RefreshTargetsClicked" Margin="6,0,0,0" Padding="10,6"/>
                                    <ComboBox x:Name="TargetBox" DisplayMemberPath="Label" SelectionChanged="SettingsChanged" ToolTip="{Binding SelectedItem.Target.CurrentFile, RelativeSource={RelativeSource Self}}"/></DockPanel>
                                <WrapPanel Margin="0,12,0,0"><Button x:Name="ApplyButton" Tag="应用到桌面|Apply to desktop" Click="ApplyClicked"/>
                                    <Button x:Name="RollbackButton" Tag="回滚到上一张|Roll back to the previous one" Click="RollbackClicked"/>
                                    <Button x:Name="RollbackFileButton" Tag="从回滚记录还原…|Restore from a rollback record…" Click="RollbackClicked"/></WrapPanel>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
        <StackPanel Grid.Row="3" Margin="0,16,0,0">
            <ProgressBar x:Name="RunProgress" Height="4" Maximum="1" BorderThickness="0" Foreground="{StaticResource Accent}" Background="#E0E6F0"/>
            <TextBlock x:Name="StatusText" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,8,0,0"/>
        </StackPanel>
    </Grid>
</Window>
