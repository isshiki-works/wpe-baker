--- a/libavcodec/vulkan_encode.c
+++ b/libavcodec/vulkan_encode.c
@@ -42,6 +42,19 @@
                                              ctx->session_params,
                                              s->hwctx->alloc);
 
+    /* Modified for Periodica (2026-09-23): ff_hw_base_encode_close() frees
+     * only the generic part of the pictures still queued at close (the
+     * references kept after EOF). Release their image views and bitstream
+     * buffers here, as the VAAPI and D3D12 encoders do, so that they do not
+     * outlive the device. */
+    for (FFHWBaseEncodePicture *pic = ctx->base.pic_start; pic; pic = pic->next) {
+        FFVulkanEncodePicture *vp = pic->priv;
+        vk->DestroyImageView(s->hwctx->act_dev, vp->in.view, s->hwctx->alloc);
+        if (!ctx->common.layered_dpb)
+            vk->DestroyImageView(s->hwctx->act_dev, vp->dpb.view, s->hwctx->alloc);
+        av_buffer_unref(&vp->pkt_buf);
+    }
+
     ff_hw_base_encode_close(&ctx->base);
 
     av_buffer_pool_uninit(&ctx->buf_pool);
@@ -275,7 +288,12 @@
 
     encode_start = (VkVideoBeginCodingInfoKHR) {
         .sType = VK_STRUCTURE_TYPE_VIDEO_BEGIN_CODING_INFO_KHR,
-        .pNext = !base_pic->force_idr ? &rc_info : NULL,
+        /* Modified for Periodica (2026-09-23): declare the rate control
+         * state whenever the session has been reset, not only for pictures
+         * without force_idr. Omitting it on a later forced IDR picture
+         * declared the default mode while the session was configured with
+         * another one (VUID-vkCmdBeginVideoCodingKHR-pBeginInfo-08253). */
+        .pNext = ctx->session_reset ? &rc_info : NULL,
         .videoSession = ctx->common.session,
         .videoSessionParameters = ctx->session_params,
         .referenceSlotCount = encode_info.referenceSlotCount + 1,
