+    // Preserve the rational and its provenance; never substitute the capture FPS.
+    AVRational rate = stream->avg_frame_rate;
+    if (rate.num > 0 && rate.den > 0) result.fps_source = String::make("avg_frame_rate"_str);
+    else {
+        rate = stream->r_frame_rate;
+        if (rate.num > 0 && rate.den > 0) result.fps_source = String::make("r_frame_rate"_str);
+    }
+    if (rate.num > 0 && rate.den > 0) {
+        result.fps_num = Some(i32(rate.num));
+        result.fps_den = Some(i32(rate.den));
