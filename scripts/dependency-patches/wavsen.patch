+        result.time_base_num  = Some(i32(stream->time_base.num));
+        result.time_base_den  = Some(i32(stream->time_base.den));
+    }
+    if (stream->nb_frames > 0)
+        result.frame_count = Some(u64(static_cast<rstd::uint64_t>(stream->nb_frames)));
