+module wavsen.audio;
+
+import rstd;
+import rstd.log;
+import rstd.cppstd;
+import :core;
+
+using namespace rstd::prelude;
+using namespace rstd::literals;
+
+namespace wavsen::audio {
+
+// A linkable, explicit unsupported-device boundary for portable offline builds.
+// Actual audio processing lives in SoundManager::mix_pcm/StreamDecoder. This
+// implementation never claims that a physical device is ready or has played PCM.
+class AudioDevice::Impl {
+public:
+    AudioDeviceEventSink sink;
+    AudioDeviceState state { AudioDeviceState::Idle };
+    u64 generation;
+
+    bool unavailable() {
+        state = AudioDeviceState::Failed;
+        auto message = String::make("system audio playback is unavailable in this offline build; use the synchronous PCM mixer"_str);
+        rstd::log::error("wavsen::audio: {}", message);
+        if (sink) sink(AudioDeviceEvent { generation, state, rstd::move(message) });
+        return false;
+    }
+};
+
+AudioDevice::AudioDevice(): impl_(Box<Impl>::make()) {}
+AudioDevice::~AudioDevice() = default;
+void AudioDevice::set_event_sink(AudioDeviceEventSink sink) { impl_->sink = rstd::move(sink); }
+bool AudioDevice::apply(AudioDeviceDesiredState desired) {
+    impl_->generation = desired.generation;
+    return impl_->unavailable();
+}
+bool AudioDevice::mount(std::unique_ptr<IPullChannel>, u64) { return impl_->unavailable(); }
+bool AudioDevice::unmount_all(u64) { return false; }
+void AudioDevice::shutdown() { impl_->state = AudioDeviceState::Stopped; }
+void AudioDevice::wait_stopped() {}
+AudioDeviceState AudioDevice::state() const { return impl_->state; }
+DeviceDesc AudioDevice::desc() const { return {}; }
+auto AudioDevice::stream_position_frames() const -> u64 { return u64(); }
+
+} // namespace wavsen::audio
