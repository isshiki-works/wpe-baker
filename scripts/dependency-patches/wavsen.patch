+++ b/tests/offline_audio_tests.cpp
@@ -0,0 +1,63 @@
+import rstd;
+import rstd.cppstd;
+import wavsen.audio;
+
+using namespace rstd::prelude;
+using namespace rstd::literals;
+
+namespace {
+class ConstantSource final : public wavsen::audio::SoundStream {
+public:
+    explicit ConstantSource(float value): value_(value) {}
+    auto next_pcm(void* dst, u32 frames) -> u64 override {
+        auto* samples = static_cast<float*>(dst);
+        for (u32 index {}; index < frames * channels_; ++index)
+            samples[index.to_primitive()] = value_;
+        consumed += u64(frames.to_primitive());
+        return u64(frames.to_primitive());
+    }
+    void pass_desc(const Desc& desc) override { channels_ = desc.channels; }
+    auto error() const -> Option<ref<str>> override {
+        return fail ? Some("synthetic decode failure"_str) : None();
+    }
+    u64 consumed;
+    bool fail {};
+private:
+    float value_;
+    u32 channels_;
+};
+}
+
+int main() {
+    wavsen::audio::SoundManager mixer;
+    auto first = std::make_unique<ConstantSource>(0.25f);
+    auto* observed = first.get();
+    mixer.mount(rstd::move(first)); // Mount before choosing an output creates no device.
+    if (mixer.is_inited()) return 1;
+    if (mixer.configure_offline({u32(2), u32(48000)}).is_err()) return 2;
+    mixer.mount(std::make_unique<ConstantSource>(0.125f));
+    rstd::array<float, 256> samples {};
+    auto silence = mixer.mix_pcm(samples.as_mut_slice());
+    if (silence.is_err() || observed->consumed != u64()) return 3;
+    mixer.play();
+    auto mixed = mixer.mix_pcm(samples.as_mut_slice());
+    if (mixed.is_err() || *mixed != u64(128)) return 4;
+    for (float sample : samples) if (sample != 0.375f) return 5;
+    mixer.set_muted(true);
+    if (mixer.mix_pcm(samples.as_mut_slice()).is_err()) return 6;
+    if (observed->consumed != u64(256)) return 7;
+    for (float sample : samples) if (sample != 0.0f) return 8;
+    mixer.pause();
+    if (mixer.mix_pcm(samples.as_mut_slice()).is_err() || observed->consumed != u64(256)) return 9;
+    mixer.play();
+    observed->fail = true;
+    if (mixer.mix_pcm(samples.as_mut_slice()).is_ok()) return 10;
+    if (mixer.is_inited()) return 11;
+    mixer.unmount_all();
+    if (mixer.mix_pcm(samples.as_mut_slice()).is_err()) return 12;
+    rstd::array<float, 3> incomplete {};
+    if (mixer.mix_pcm(incomplete.as_mut_slice()).is_ok()) return 13;
+    mixer.shutdown();
+    if (mixer.mix_pcm(samples.as_mut_slice()).is_ok()) return 14;
+    return 0;
+}
