+TEST(JsonParser, TrailingCommasRequireExplicitOption) {
+    const auto permissive = rstd::json::ParseOptions { .allow_trailing_commas = true };
+
+    EXPECT_TRUE(parse("[1,]"_str).is_err());
+    EXPECT_TRUE(parse("{\"a\":1,}"_str).is_err());
+    EXPECT_TRUE(rstd::json::from_str("[1,{\"nested\":[2,],},]"_str, permissive).is_ok());
+    EXPECT_TRUE(rstd::json::from_str("{\"a\":[1,],\"b\":{\"c\":2,},}"_str, permissive).is_ok());
+    EXPECT_TRUE(rstd::json::from_str(R"({"text":"comma,] remains text",})"_str, permissive).is_ok());
+    EXPECT_TRUE(rstd::json::from_str("[1,,2]"_str, permissive).is_err());
+    EXPECT_TRUE(rstd::json::from_str("{\"a\":1,,\"b\":2}"_str, permissive).is_err());
+}
