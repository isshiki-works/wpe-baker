<?xml version="1.0" encoding="utf-8"?>
<!--
  仓库级包源：只认 nuget.org。
  还原结果不该取决于本机用户级 NuGet.Config：本机那份的 packageSources 是空的，没有这个文件时
  首次还原测试工程（xunit.v3 等）得在命令行手动指定 nuget.org 源；新检出和 CI 也靠它拿到同一个确定的包源。
  <clear /> 丢掉机器级和用户级配置里的其它源，避免私有源或镜像悄悄换包。
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
