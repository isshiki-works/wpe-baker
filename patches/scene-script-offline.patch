+        JS_NewCFunction(ctx, OfflineUnsupported, "offlineUnsupported", 1));
+    JSValue math = JS_GetPropertyStr(ctx, global, "Math");
+    JS_SetPropertyStr(ctx, math, "random", JS_NewCFunction(ctx, OfflineRandom, "random", 0));
