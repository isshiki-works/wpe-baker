++/* Software decoding runs on the caller's thread by default, which makes a
++ * synchronous per-frame pull of a 4K H.264 stream cost the whole frame budget.
++ * libavcodec's frame/slice threading is bit-exact for the codecs we decode, so
++ * it can be enabled unconditionally for the pure-sw path.
++ *
++ * WAVSEN_VIDEO_DECODE_THREADS overrides the worker count:
++ *   unset / 0 / invalid -> automatic (libavcodec picks by cpu count)
++ *   1                   -> single-threaded, the pre-2026-09 behaviour
++ *   n                   -> n workers (clamped to 64) */
++int decode_thread_count_from_env() {
++    const char* raw = std::getenv("WAVSEN_VIDEO_DECODE_THREADS");
++    if (! raw || ! raw[0]) return 0;
++    char* end   = nullptr;
++    long  value = std::strtol(raw, &end, 10);
++    if (end == raw || value < 0 || value > 64) return 0;
++    return static_cast<int>(value);
++}
++
+ } // namespace _wv_avcodec
+ 
+ export {
+@@ -118,6 +137,15 @@
+         return _wv_avcodec::prepare_vulkan_decode_frames(frames_ref);
+     }
+ 
++    /* Request frame+slice threading on a software decoder before
++     * avcodec_open2. FF_THREAD_* are macros and cannot cross the module
++     * boundary, so the request is wrapped here. */
++    inline void avcodec_request_sw_threads(AVCodecContext* cctx) {
++        if (! cctx) return;
++        cctx->thread_count = _wv_avcodec::decode_thread_count_from_env();
++        cctx->thread_type  = FF_THREAD_FRAME | FF_THREAD_SLICE;
++    }
++
